# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 虚拟环境
# =========================
.venv/
venv/
env/

# =========================
# 打包 / 构建
# =========================
build/
dist/
*.egg-info/
.eggs/

# =========================
# 测试 / 缓存
# =========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# 环境变量与密钥
# =========================
# .env 含真实 API Key，绝不能提交；示例文件要保留
.env
.env.*
!.env.example

# =========================
# 日志
# =========================
logs/
*.log

# =========================
# 运行时生成的数据
# =========================
# 向量库：可随时由 data/career/knowledge 重建，不入库
chroma_db/

# md5.txt 记录"哪些文件已灌库"，必须和 chroma_db 一起忽略。
# 若只提交 md5.txt 而不提交向量库，新环境启动会误判"已存在"并跳过全部文件，
# 结果是知识库为空、检索永远命中不到内容。
md5.txt

# 两个 SQLite：对话状态可丢弃，业务库由 seed_demo_data.py 生成
checkpoints.db
career_pilot.db

# 简历导出与用户上传的截图（含他人简历、个人图片），属于隐私材料
data/picture/*
!data/picture/.gitkeep

# =========================
# 临时文件
# =========================
tmp/
temp/
*.tmp
*.bak

# =========================
# Streamlit
# =========================
.streamlit/secrets.toml

# =========================
# IDE / 编辑器
# =========================
.idea/
.vscode/

# =========================
# 操作系统
# =========================
.DS_Store
Thumbs.db

# =========================
# AI 工作区（个人记录，不入库）
# =========================
.workbuddy/
